# On a brand-new environment, use false for the first infrastructure apply,
# then true for the second apply from the private jumpbox/provisioner/runner.
deploy_external_load_balancer = true

# Infrastructure only: no application or ingress controller is installed.
# Your ingress deployment must use this namespace, these pod labels and port.
external_application = {
  service_name = "applications-public"
  namespace    = "default"
  selector     = { "app.kubernetes.io/name" = "applications-ingress" }
  ports        = [{ name = "https", port = 443, target_port = 443 }]
}

public_dns_zone_name   = "neftexaz.com"
public_dns_record_name = "geoweb"

# Use the existing provisioner's managed identity (the default login is msi).
# Set the client ID only when selecting an existing user-assigned identity.
# kubernetes_managed_identity_client_id = "existing-identity-client-id"
# kubernetes_login_method = "azurecli" # Interactive sign-in, if appropriate.
